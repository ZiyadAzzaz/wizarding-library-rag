# Application
APP_NAME=Wizarding Library RAG
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Retrieval (local Qdrant is the default; set URL/key for Qdrant Cloud)
QDRANT_PATH=backend/data/vector_store
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=harry_potter_books
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HASHING_DIMENSIONS=768
TOP_K=4
MIN_RELEVANCE_SCORE=0.25

# Generation (local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
ALLOW_EXTRACTIVE_FALLBACK=true

# Frontend
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=90
